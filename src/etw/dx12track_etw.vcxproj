<?xml version="1.0" encoding="utf-8"?>
<!--
  dx12track_etw.lib: dx12track's ETW consumer (EtwMonitor.cpp) compiled together
  with DxTimingCaptureLibrary's own sources, taken unmodified from the
  external/DxTimingCaptureLibrary submodule. Linked into the launcher.

  Why a separate project:
  - The library needs C++20 and the Agility SDK headers (unprefixed
    <d3d12.h>, <D3D12Events.h>); the rest of dx12track is C++17 on vcpkg's
    <directx/d3d12.h>. Keeping them in different TUs/projects avoids mixing two
    d3d12.h versions.
  - The library's own lib\DxTimingCaptureLibrary.lib.vcxproj writes into the
    submodule and uses the DLL CRT; here everything lands under build\ and uses
    the launcher's static CRT (/MT, /MTd).

  The Agility SDK headers come from the checked-in copy in
  external\AgilitySDK\include (see its README.md), not from the
  Microsoft.Direct3D.D3D12 NuGet package the library's standalone build
  references: Visual Studio doesn't restore PackageReference for native
  projects. No NuGet restore is needed.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{4E1F0A11-7E9C-4A55-9D43-6F1A2C7B0003}</ProjectGuid>
    <RootNamespace>dx12track_etw</RootNamespace>
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <Dx12TrackRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</Dx12TrackRoot>
    <!-- Drops the library's Microsoft.Direct3D.D3D12 PackageReference (the
         only thing this property gates); the headers come from
         external\AgilitySDK\include instead (see AdditionalIncludeDirectories). -->
    <DxTimingCaptureStandaloneBuild>false</DxTimingCaptureStandaloneBuild>
    <!-- The library resolves <d3d12.h> from the vendored Agility SDK headers;
         keep vcpkg's DirectX-Headers off this project's include path. -->
    <VcpkgEnabled>false</VcpkgEnabled>
    <VcpkgEnableManifest>false</VcpkgEnableManifest>
  </PropertyGroup>

  <!-- The library's standalone build settings: x64 Debug/Release configurations,
       toolset, Windows SDK, C++20 and include dirs (include\, third_party\dxgk,
       third_party\directstorage). Must come after ConfigurationType and before
       Microsoft.Cpp.Default.props. -->
  <Import Project="$(Dx12TrackRoot)external\DxTimingCaptureLibrary\Directory.Build.props" />

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(Dx12TrackRoot)build\x64\$(Configuration)\lib\</OutDir>
    <IntDir>$(Dx12TrackRoot)build\x64\$(Configuration)\obj\etw\</IntDir>
    <TargetName>dx12track_etw</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- Vendored Agility SDK headers first, so their d3d12.h / d3dcommon.h /
           dxgiformat.h win over the Windows SDK's older copies. The library's
           public headers also need the PixEventDecoder headers. -->
      <AdditionalIncludeDirectories>$(Dx12TrackRoot)external\AgilitySDK\include;$(PixEventDecoderPath)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="EtwMonitor.cpp" />
    <ClInclude Include="EtwMonitor.h" />
  </ItemGroup>

  <!-- DxTimingCaptureLibrary (same sources as its lib\DxTimingCaptureLibrary.lib.vcxproj).
       4996 (<codecvt> deprecation) and 4309 (constant truncation) come from the
       library's own code; suppressed for these files only. -->
  <ItemGroup>
    <ClCompile Include="$(DxTimingCaptureLibraryRoot)\lib\AllocationTracker.cpp">
      <DisableSpecificWarnings>4996;4309;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="$(DxTimingCaptureLibraryRoot)\lib\D3D12ObjectProcessor.cpp">
      <DisableSpecificWarnings>4996;4309;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="$(DxTimingCaptureLibraryRoot)\lib\DxTimingCaptureEventHandler.cpp">
      <DisableSpecificWarnings>4996;4309;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="$(DxTimingCaptureLibraryRoot)\lib\PixEventDecoderStub.cpp" Condition="'$(UseStubPixEventDecoder)' == 'true'">
      <DisableSpecificWarnings>4996;4309;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
